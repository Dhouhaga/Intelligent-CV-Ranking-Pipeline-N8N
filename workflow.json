    },
    {
      "parameters": {
        "jsCode": "const agentInput = $input.all().map(item => ({\n  fileName: item.binary.originalFileName?.fileName || 'unknown.pdf',\n  id: item.binary.originalFileId?.fileName || 'missing_id',\n  pdfText: item.json.text || ''\n}));\n\nreturn [\n  {\n    json: {\n      agentInput\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
