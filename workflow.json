    {
      "parameters": {
        "jsCode": "// Get the raw output string\nconst raw = $json.output || \"\";\n\n// Remove markdown fences and trim\nconst cleaned = raw\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Parse JSON safely\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = [];\n}\n\n// Ensure parsed is an array\nif (!Array.isArray(parsed)) {\n  parsed = [parsed];\n}\n\n// Map each candidate to its driveLink\nreturn parsed.map(candidate => ({\n  json: {\n    fileName: candidate.fileName || \"\",\n    driveLink: candidate.driveLink || \"\"\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        -128
      ],
      "id": "026ef0bc-32d0-4dc5-ad70-180965174064",
      "name": "CV link parser"
    },
    {
      "parameters": {
        "jsCode": "// Collect all incoming items\nconst items = $input.all();\n\n// Determine the candidate list:\n// - If a single item contains an array in its json, unwrap it.\n// - Otherwise, treat each incoming item as one candidate.\nlet candidates;\n\nif (\n  items.length === 1 &&\n  Array.isArray(items[0].json)\n) {\n  // Case: the upstream produced one item whose json is an array\n  candidates = items[0].json;\n} else if (\n  items.length === 1 &&\n  typeof items[0].json === 'string'\n) {\n  // Case: a raw JSON string was passed\n  try {\n    const parsed = JSON.parse(items[0].json);\n    candidates = Array.isArray(parsed) ? parsed : [parsed];\n  } catch {\n    candidates = [ { fileName: 'unknown', driveLink: items[0].json } ];\n  }\n} else {\n  // Case: multiple items, each with a candidate object\n  candidates = items.map(i => i.json);\n}\n\n// Build the text content\nlet content = \"Best Candidates Resumes Links:\\n\\n\";\nfor (const c of candidates) {\n  const fileName = c.fileName || \"unknown\";\n  const driveLink = c.driveLink || \"\";\n  content += `${fileName}: ${driveLink}\\n\\n`;\n}\n\n// Output as a single TXT file (binary)\nreturn [\n  {\n    json: {},\n    binary: {\n      data: {\n        data: Buffer.from(content).toString('base64'),\n        fileName: 'best_candidates_links.txt',\n        mimeType: 'text/plain'\n      }\n    }\n  }\n];\n"
      },
