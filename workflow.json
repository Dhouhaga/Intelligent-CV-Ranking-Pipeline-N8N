        80
      ],
      "id": "9722ca01-d8aa-4d1f-9866-deae726aa83e",
      "name": "OpenRouter Chat Model",
      "credentials": {
        "openRouterApi": {
          "id": "YOUR_OPENROUTER_API_KEY",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n    item.binary.originalFileName = {\n        fileName: item.json.name,\n        data: null\n    };\n    item.binary.originalFileId = {\n        fileName: item.json.id,\n        data: null\n    };\n    return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        0
      ],
      "id": "b28e4922-87a6-4b30-b38c-e0896845e17a",
